{
  "name": "Unit",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 1
    },
    "video_url": {
      "type": "string"
    },
    "video_duration_minutes": {
      "type": "number"
    }
  },
  "required": [
    "course_id",
    "title",
    "order"
  ]
}