{
  "name": "Question",
  "type": "object",
  "properties": {
    "unit_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "question_text": {
      "type": "string"
    },
    "option_a": {
      "type": "string"
    },
    "option_b": {
      "type": "string"
    },
    "option_c": {
      "type": "string"
    },
    "option_d": {
      "type": "string"
    },
    "correct_answer": {
      "type": "string",
      "enum": [
        "a",
        "b",
        "c",
        "d"
      ]
    },
    "explanation": {
      "type": "string"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "unit_quiz",
        "exam_simulation"
      ],
      "default": "unit_quiz"
    }
  },
  "required": [
    "course_id",
    "question_text",
    "option_a",
    "option_b",
    "option_c",
    "option_d",
    "correct_answer",
    "question_type"
  ]
}