{
  "name": "DiscountCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "percentage": {
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    "max_uses": {
      "type": "number",
      "default": 1
    },
    "uses_count": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "percentage"
  ]
}