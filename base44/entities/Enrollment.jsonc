{
  "name": "Enrollment",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending"
    },
    "enrolled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "course_id"
  ]
}